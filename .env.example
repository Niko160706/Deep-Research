# Deep Research AI Agent — environment secrets (contoh)
# Salin file ini menjadi `.env` lalu isi dengan key Anda.
# File `.env` JANGAN di-commit ke Git.

# Brave Search API — https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Tavily Search API — https://tavily.com/
TAVILY_API_KEY=

# Exa.ai Search API — https://exa.ai/
EXA_API_KEY=

# SearXNG lokal (dijalankan via docker-compose)
SEARXNG_URL=

# TOR SOCKS proxy (dijalankan via docker-compose)
TOR_PROXY=

# DeepSeek API — https://platform.deepseek.com/ (dipakai mulai Phase 2)
DEEPSEEK_API_KEY=

# Groq — PRIMARY + SECONDARY provider hierarchy.
# https://console.groq.com/keys
# Primary: openai/gpt-oss-120b, secondary: qwen/qwen3.8-27b
GROQ_API_KEY=
# Gemini — TERTIARY/last-resort (free tier ~20 request/hari).
GEMINI_API_KEY=
# OpenRouter — explicit-only (tidak masuk rantai auto).
OPENROUTER_API_KEY=
